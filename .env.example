# These values are embedded in the Expo client and must be safe to disclose.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Never add a service-role key, database password, JWT signing secret, or other
# privileged credential to an EXPO_PUBLIC_* variable.
