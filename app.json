{
  "expo": {
    "name": "SideQuest",
    "slug": "sidequest",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sidequest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sidequest.app"
    },
    "android": {
      "package": "com.sidequest.app",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SideQuest to choose Quest proof and profile images.",
          "cameraPermission": "Allow SideQuest to take Quest proof and profile images."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SideQuest to use your location while finding nearby Quests."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "085389ec-723f-4e81-924d-2c01d45cba6b"
      }
    }
  }
}
