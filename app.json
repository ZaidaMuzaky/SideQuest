{
  "expo": {
    "name": "SideQuest",
    "slug": "sidequest",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sidequest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sidequest.app"
    },
    "android": {
      "package": "com.sidequest.app",
      "predictiveBackGestureEnabled": true,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "CAMERA", "READ_MEDIA_IMAGES"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", {"photosPermission": "Allow SideQuest to choose Quest proof and profile images.", "cameraPermission": "Allow SideQuest to take Quest proof and profile images."}],
      ["expo-location", {"locationWhenInUsePermission": "Allow SideQuest to use your location while finding nearby Quests."}]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
